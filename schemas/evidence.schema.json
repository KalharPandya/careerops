{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "CareerOps Evidence",
  "description": "A source that backs one or more facts",
  "type": "object",
  "required": ["id", "type", "source", "attestation", "verified_at", "backs_facts"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^E-"
    },
    "type": {
      "type": "string",
      "enum": ["certificate", "url", "file", "screenshot", "testimonial", "pr", "commit", "email"]
    },
    "source": { "type": "string" },
    "attestation": {
      "type": "string",
      "enum": ["self-attested", "third-party-verified", "public-record"]
    },
    "verified_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "backs_facts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^F-" },
      "minItems": 1
    },
    "notes": { "type": "string" }
  }
}
